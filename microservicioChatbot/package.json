{
  "name": "microservicio-chatbot",
  "version": "1.0.0",
  "description": "Microservicio de chatbot (sesiones y mensajes) para Bizihotz",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "migrate-names": "node scripts/migratePersistedNames.js",
    "coverage": "c8 --reporter=text --reporter=html --report-dir coverage --check-coverage --lines 80 --exclude=test/** --exclude=src/config/env.js --exclude=src/services/aiService.js npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  }
}
