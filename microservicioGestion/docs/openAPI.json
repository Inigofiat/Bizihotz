        "summary": "Listar historiales",
        "parameters": [
          {
            "name": "idPaciente",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtra por idPaciente"
          },
          {
            "name": "idUsuario",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtra por idUsuario"
          },
          {
            "name": "idCita",
