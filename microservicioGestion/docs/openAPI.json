{
  "openapi": "3.0.3",
  "info": {
    "title": "Bizihotz - Microservicio de Gestion",
    "version": "1.0.0",
    "description": "Documentacion de la API para el microservicio de gestion de pacientes, citas e historiales."
  },
  "servers": [
    {
      "url": "http://localhost:4001",
      "description": "Servidor local"
    }
  ],
  "tags": [
    {
      "name": "Pacientes"
    },
    {
      "name": "Citas"
    },
    {
      "name": "Historiales"
    },
    {
      "name": "Registros antropométricos"
    },
    {
      "name": "Pacientes-Usuarios"
    },
    {
      "name": "Auth"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/pacientes": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Listar pacientes",
        "parameters": [
          {
            "name": "buscar",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Texto para buscar por nombre, apellidos, email o teléfono"
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "activo",
                "baja"
              ]
            },
            "description": "Filtrar por estado exacto."
          },
          {
            "name": "incluirBaja",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Si es false, se excluyen los pacientes dados de baja. Por defecto es true (se incluyen)."
          },
          {
            "name": "incluirInactivos",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Alias de incluirBaja."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Número de página (paginación opcional)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "description": "Tamaño de página (por defecto 20 si se envía page/limit)."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "createdAt:desc"
            },
            "description": "Orden, p.ej. createdAt:desc o nombrePaciente:asc."
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de pacientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Paciente"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pacientes"
        ],
        "summary": "Crear paciente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PacienteInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Paciente creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
