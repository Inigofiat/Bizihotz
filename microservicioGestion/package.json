{
  "name": "microserviciogestion",
  "version": "1.0.0",
  "description": "Microservicio de gestion de pacientes y citas (Bizihotz)",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "coverage": "c8 --reporter=text --reporter=html --report-dir coverage --check-coverage --lines 80 --exclude=test/** --exclude=src/index.js --exclude=src/config/** --exclude=src/routes/pacienteRutas.js --exclude=src/routes/pacienteUsuarioRutas.js --exclude=src/routes/registroRutas.js --exclude=src/routes/usuarioRutas.js --exclude=src/services/** npm test",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node scripts/seed.js",
    "migrate-names": "node scripts/migratePersistedNames.js",
    "purge-weekend-citas": "node scripts/deleteWeekendCitas.js"
  },
  "keywords": [
    "node",
    "mongodb",
    "mongoose",
    "backend"
  ],
  "author": "Inigo Fiat Sarasola",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.7.0",
    "mongoose": "^8.19.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}
