{
  "openapi": "3.0.3",
  "info": {
    "title": "Bizihotz - Microservicio de Comunicación",
    "version": "1.0.0",
    "description": "API REST para mensajería interna entre profesionales. Incluye soporte en tiempo real mediante Socket.IO (eventos `message:new`, `message:read`, `conversation:read`)."
  },
  "servers": [
    {
      "url": "http://localhost:4100",
      "description": "Desarrollo local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Comprobar estado del servicio",
        "responses": {
          "200": {
            "description": "Servicio operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/messages": {
      "post": {
        "summary": "Enviar un mensaje",
        "tags": ["Mensajes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mensaje creado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/messages/{messageId}/read": {
      "patch": {
        "summary": "Marcar un mensaje como leído",
        "tags": ["Mensajes"],
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "objectId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "readerId": {
                    "type": "string"
                  }
                },
                "required": ["readerId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mensaje actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "summary": "Listar conversaciones de un usuario",
        "tags": ["Conversaciones"],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de conversaciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Conversation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}/messages": {
      "get": {
        "summary": "Obtener mensajes de una conversación",
        "tags": ["Conversaciones"],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "objectId"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mensajes paginados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation": {
                      "$ref": "#/components/schemas/Conversation"
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Message"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversationId}/read": {
      "patch": {
        "summary": "Marcar toda la conversación como leída",
        "tags": ["Conversaciones"],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "objectId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "readerId": {
                    "type": "string"
                  }
                },
                "required": ["readerId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversación actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Conversation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "service": { "type": "string" },
          "db": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "hasMore": { "type": "boolean" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "conversationId": { "type": "string" },
          "senderId": { "type": "string" },
          "recipientId": { "type": "string" },
          "content": { "type": "string" },
          "attachments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attachment" }
          },
          "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
          "readAt": { "type": "string", "format": "date-time", "nullable": true },
          "sentAt": { "type": "string", "format": "date-time" }
        }
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string" },
          "name": { "type": "string" },
          "size": { "type": "integer" }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "participants": {
            "type": "array",
            "items": { "type": "string" }
          },
          "unreadCounts": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          },
          "lastMessage": { "$ref": "#/components/schemas/Message" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "SendMessageInput": {
        "type": "object",
        "properties": {
          "senderId": { "type": "string" },
          "recipientId": { "type": "string" },
          "conversationId": { "type": "string" },
          "content": { "type": "string" },
          "attachments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attachment" }
          }
        },
        "required": ["senderId", "recipientId"]
      }
    }
  }
}
